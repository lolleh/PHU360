<?xml version="1.0" encoding="UTF-8"?>
<!--
  Context descriptor for the OpenMRS webapp.
  Tomcat applies conf/Catalina/localhost/*.xml in preference to
  META-INF/context.xml. The RewriteValve is configured here with an
  explicit config path so the redirect rules in WEB-INF/rewrite.config
  (root -> /openmrs/spa/index.html, login.htm -> /openmrs/spa/index.html)
  are honoured.
-->
<Context antiJARLocking="true" reloadable="false" useHttpOnly="false" docBase="openmrs.war">
  <Valve className="org.apache.catalina.valves.rewrite.RewriteValve" config="WEB-INF/rewrite.config" />
</Context>
