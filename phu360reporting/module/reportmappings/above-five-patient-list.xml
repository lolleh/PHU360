<?xml version="1.0" encoding="UTF-8"?>
<!--
     Data mapping for the above-five-patient-list REPORT TYPE.
-->
<reportMapping>

    <!-- The key the reportApi request carries and the filename of this file. -->
    <key>above-five-patient-list</key>
    <label>Above Five Register - Patient List</label>
    <table>phu360_report_above_five_patient_list</table>

    <!--
         Whether a mapping is defined. A report without one is reported back to the
         dashboard as reportMapped:false rather than visualized, and its table is left
         empty - see ReportFilter.obsConceptsMissing() for the other way a mapping
         can turn out to be absent, which is that its concepts are not in this database.
    -->
    <mapped>true</mapped>

    <!--
         The report's own layout is answered entirely from the encounter and patient
         tables, so the obs concepts below do NOT gate it.

         They used to. This mapping carried the 15 concept ids the data package that
         exported the report assigned, and obsConceptsMissing() reported the whole
         report unmapped when none of them were in the database - which is every
         install that has not loaded that particular package. The report was then
         refused with "has no data mapping configured yet", a message about the
         mapping being absent, sent to a reader looking for a missing mapping file
         that was sitting in front of them. The layout is encounters, patients and
         age bands; none of them reads obs, so their absence cannot change a figure
         on this page. The concepts are kept below because they ARE the register's
         condition filter and belong on any query that needs a patient's conditions,
         but they no longer decide whether this report renders.
    -->

    <!--
         Encounter type NAMES, resolved to ids per installation by
         ReportCatalog.Report.getEncounterTypeIds(). Names rather than ids so one
         mapping survives a data package that loads a different id set.

         "Visit Note" is the type the register's own form is attached to - see
         openmrs-forms/above-five-treatment-register/CONCEPT_MAPPING.md, which
         assigns the form to it at save time. The names this mapping used to
         carry, "PHU360 Outpatient Initial" and "PHU360 Outpatient Followup", are
         not the register's encounter types and do not exist in any install; they
         resolved to nothing everywhere, so the report had no way to tell which
         visits were the register's.
    -->
    <encounterTypes>
        <encounterType>Visit Note</encounterType>
    </encounterTypes>

    <!-- Obs concept ids. Ids rather than names: the concepts are referenced by the
         data package that exports them, and this database resolves them by id. -->
    <obsConcepts>
        <obsConcept>8842</obsConcept>
        <obsConcept>8840</obsConcept>
        <obsConcept>8838</obsConcept>
        <obsConcept>8839</obsConcept>
        <obsConcept>8844</obsConcept>
        <obsConcept>8774</obsConcept>
        <obsConcept>8851</obsConcept>
        <obsConcept>8848</obsConcept>
        <obsConcept>8849</obsConcept>
        <obsConcept>8852</obsConcept>
        <obsConcept>8850</obsConcept>
        <obsConcept>8841</obsConcept>
        <obsConcept>8846</obsConcept>
        <obsConcept>8843</obsConcept>
        <obsConcept>8845</obsConcept>
        <obsConcept>8847</obsConcept>
    </obsConcepts>

    <!-- The value_coded those obs must carry, or 0 for unconstrained. -->
    <obsValue>8853</obsValue>

    <!--
         ============================================================================
         LAYOUT

         The Morbidity Summary counts conditions; this one is the patient list, so
         it answers who came, and leaves what for to the summary that already does
         it. Repeating the register's hundred tick-boxes here would give the two
         reports the same chart under two names and put the register's condition
         list in two files that could drift apart.

         Both indicators are answered from the encounter and patient tables rather
         than from obs, so this page works on a database that has never loaded the
         register's data package - which is the state this installation is in, and
         the reason the Morbidity Summary reports itself unmapped.
    ============================================================================
    -->
    <indicators>
        <indicator>
            <key>encounters</key>
            <label>Outpatient visits recorded</label>
            <kind>encounterCount</kind>
        </indicator>
        <indicator>
            <key>patients</key>
            <label>Patients seen</label>
            <kind>distinctPatients</kind>
        </indicator>
    </indicators>

    <sections>
        <!--
             The same banding the Under Five register uses. The neonatal bands go
             to eleven months on an above-five list because babies do attend, and
             because a register that renumbered its own bands per report type
             would not be comparable between them.
        -->
        <section>
            <key>ageBands</key>
            <label>Patients by age band</label>
            <kind>ageBreakdown</kind>
        </section>
    </sections>

</reportMapping>
