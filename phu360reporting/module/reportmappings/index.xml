<?xml version="1.0" encoding="UTF-8"?>
<!--
     The REPORT TYPEs the dashboard offers, in the order the filter shows them.

     One <report> per mapping file, in this order, and the file is named after the
     key. The build checks that this list and the files in the directory are the same
     set, so a mapping file cannot be added here and quietly never load.
-->
<reportCatalog>
    <report>all-encounter</report>
    <report>above-five-morbidity</report>
    <report>above-five-patient-list</report>
    <report>under-five-register</report>
    <report>hf1-summary</report>
    <report>hf2-summary</report>
    <report>hf3-summary</report>
    <report>hf5-summary</report>
    <report>hf12-summary</report>
    <report>mother-and-neonate</report>
</reportCatalog>
