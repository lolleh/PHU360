<?xml version="1.0" encoding="UTF-8"?>
<!--
     Data mapping for the delivery-register REPORT TYPE.

     The labour and delivery register is a checklist of care given during
     delivery, and its dashboard is a quality one: the workbook asks how many
     deliveries there were, and then what share got a partograph, a uterotonic,
     early breastfeeding, and family planning counselling. Those are the
     questions the register is filled in to answer, so they are what this report
     leads with.
-->
<reportMapping>

    <!-- The key the reportApi request carries and the filename of this file. -->
    <key>delivery-register</key>
    <label>Delivery Register</label>
    <table>phu360_report_delivery_register</table>

    <mapped>true</mapped>

    <!-- Encounter type NAMES, resolved to ids per installation. -->
    <encounterTypes>
        <encounterType>MCH Delivery</encounterType>
        <encounterType>Labor and Delivery Summary</encounterType>
        <encounterType>Labour Progress</encounterType>
        <encounterType>Maternity and Delivery Register</encounterType>
        <encounterType>Delivery Register</encounterType>
        <encounterType>Maternal Death</encounterType>
        <encounterType>Maternal Discharge</encounterType>
        <encounterType>PHU360 Maternal Check-in</encounterType>
        <encounterType>PHU360 MCH Triage</encounterType>
    </encounterTypes>

    <!--
         ============================================================================
         LAYOUT

         Volume, outcome, then the care-quality checks. Kept to the labour
         register's own fields (the DR series) rather than reusing the mother and
         neonate layout: DR is a different set of questions from D, and a report
         that quietly mixed the two would show a partograph rate built from a
         field a delivery record does not have.
    ============================================================================
    -->
    <indicators>
        <indicator>
            <key>deliveries</key>
            <label>Total deliveries</label>
            <kind>encounterCount</kind>
        </indicator>
        <indicator>
            <key>distinctPatients</key>
            <label>Women delivered</label>
            <kind>distinctPatients</kind>
        </indicator>

        <!--
             Outcome. A live birth share, counted from the register's own outcome
             field rather than from the presence of a baby: DR records a single
             answer for how the birth ended, and the count of "alive" is the
             figure a district reads.
        -->
        <indicator>
            <key>liveBirthRate</key>
            <label>Live births</label>
            <kind>codedRate</kind>
            <concept>MNR DR20 Delivery outcome</concept>
            <answer>MNR DR20 Delivery outcome :: Alive</answer>
        </indicator>

        <!-- Care quality: the five checks the register is filled in to record. -->
        <indicator>
            <key>partographUsed</key>
            <label>Partograph / labour care guide used</label>
            <kind>codedRate</kind>
            <concept>MNR DR21 Partograph / Labour Care Guide used?</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>uterotonicGiven</key>
            <label>Uterotonic given</label>
            <kind>codedRate</kind>
            <concept>MNR DR22 Uterotonic given immediately after birth? (Oxytocin / Misoprostol)</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>breastfedWithin1h</key>
            <label>Breastfeeding within 1 hour</label>
            <kind>codedRate</kind>
            <concept>MNR DR29 New born condition - Breast feeding initiated within one hour after birth</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>fpCounselled</key>
            <label>Postpartum family planning counselled</label>
            <kind>codedRate</kind>
            <concept>MNR DR40 Post-Partum Family Planning - Counselled on family planning before discharge</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>fpReceived</key>
            <label>Postpartum family planning received</label>
            <kind>codedRate</kind>
            <concept>MNR DR41 Post-Partum Family Planning - Accepted and received family planning before discharge</concept>
            <answer>Yes</answer>
        </indicator>
    </indicators>

    <!--
         Delivery type is the workbook's chart for this dashboard, and the one
         place a reader goes to see the caesarean share the hard way round. The
         codes are given labels so the bars read "Normal" and "Elective CS"
         rather than the dictionary's full names.
    -->
    <sections>
        <section>
            <key>deliveryType</key>
            <label>Delivery type</label>
            <kind>codedBreakdown</kind>
            <concept>MNR DR19 Delivery type</concept>
        </section>
        <section>
            <key>deliveryOutcome</key>
            <label>Delivery outcome</label>
            <kind>codedBreakdown</kind>
            <concept>MNR DR20 Delivery outcome</concept>
        </section>
        <section>
            <key>placeOfDelivery</key>
            <label>Place of delivery</label>
            <kind>codedBreakdown</kind>
            <concept>MNR DR47 Place of delivery</concept>
        </section>
    </sections>

</reportMapping>
