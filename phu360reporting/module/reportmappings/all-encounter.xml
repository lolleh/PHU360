<?xml version="1.0" encoding="UTF-8"?>
<!--
     Data mapping for the all-encounter REPORT TYPE.
     Feeds phu360_report_all_encounter. See the reportmappings section of README.md.
-->
<reportMapping>

    <!-- The key the reportApi request carries and the filename of this file. -->
    <key>all-encounter</key>
    <label>All Encounter</label>
    <table>phu360_report_all_encounter</table>

    <!--
         Whether a mapping is defined. A report without one is reported back to the
         dashboard as reportMapped:false rather than visualized, and its table is left
         empty - see ReportFilter.obsConceptsMissing() for the other way a mapping
         can turn out to be absent, which is that its concepts are not in this database.
    -->
    <mapped>true</mapped>

</reportMapping>
