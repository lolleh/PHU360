    <!-- The value_coded those obs must carry, or 0 for unconstrained. -->
    <obsValue>8853</obsValue>

    <!--
         ============================================================================
         LAYOUT

         A treatment register is a list of conditions seen, not a count of visits,
         so the indicators are the ones a district clinician asks about at review:
         how many people were seen, how much of it was malaria, how much was
         treated late or without the right drug, and how many of the
         notifiable diseases were among them.

         Every figure is a SHARE OF THE ENCOUNTERS THAT ANSWERED, not a share of
         all visits: a visit that left the field blank is missing data, and scoring
         it as a "no" would understate every rate in proportion to how well the
         register is being filled in. ReportIndicators therefore divides by the
         encounters carrying the concept with any answer.

         A share whose bad outcome is the "no" answer is marked inverted, so it is
         reported as the share WITHOUT the complication. "Malaria treated with ACT
         within 24h" and "malaria treated without ACT" are opposites, and showing
         only the first of a matched pair would hide half the finding.
    ============================================================================
    -->
    <indicators>
        <indicator>
            <key>visits</key>
            <label>Treatment visits recorded</label>
            <kind>encounterCount</kind>
        </indicator>
        <indicator>
            <key>malaria</key>
            <label>Malaria (suspected fever)</label>
            <kind>codedCount</kind>
            <concept>Above Five treatment visit condition: Fever cases (suspected malaria)</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>rdtPositivity</key>
            <label>RDT positivity</label>
            <kind>codedRate</kind>
            <concept>RDT positive</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>actWithin24h</key>
            <label>Malaria treated with ACT within 24h</label>
            <kind>codedRate</kind>
            <concept>Malaria treated with ACT less than 24 hours</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>actOver24h</key>
            <label>Malaria treated with ACT after 24h</label>
            <kind>codedRate</kind>
            <concept>Malaria treated with ACT more than 24 hours</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>noAct</key>
            <label>Malaria treated without ACT</label>
            <kind>codedRate</kind>
            <concept>Malaria treated at facility without ACT</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>severeMalariaArtesunate</key>
            <label>Severe malaria treated with artesunate</label>
            <kind>codedRate</kind>
            <concept>Severe malaria treated with Artesunate (IV/IM &amp; supp)</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>severePneumonia</key>
            <label>Severe pneumonia treated with oxygen</label>
            <kind>codedRate</kind>
            <concept>Severe pneumonia treated with oxygen therapy</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>diarrhoeaBlood</key>
            <label>Diarrhoea with blood (ORS + Zinc)</label>
            <kind>codedRate</kind>
            <concept>Diarrhoea with blood treated with ORS and Zinc</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>severeDehydration</key>
            <label>Diarrhoea with severe dehydration</label>
            <kind>codedRate</kind>
            <concept>Diarrhoea with severe dehydration</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>severeMalnutrition</key>
            <label>Severe malnutrition</label>
            <kind>codedRate</kind>
            <concept>Severe malnutrition</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>afp</key>
            <label>Acute flaccid paralysis (AFP)</label>
            <kind>codedRate</kind>
            <concept>Acute flaccid paralysis (AFP)</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>avhf</key>
            <label>Acute viral haemorrhagic fever</label>
            <kind>codedRate</kind>
            <concept>Acute viral haemorrhagic fever (AVHF)</concept>
            <answer>Yes</answer>
        </indicator>
        <!--
             The four below are the register's own groupings, not the stock
             dictionary diseases of the same names. A register writes "Cardiovascular
             disease (all types)" as one tick, and a patient is ticked once; naming
             CIEL "Hypertension" instead would count every hypertension DIAGNOSIS any
             form on the encounter recorded, which is a different and much larger
             number than the register's column.
        -->
        <indicator>
            <key>cardiovascular</key>
            <label>Cardiovascular disease</label>
            <kind>codedRate</kind>
            <concept>Cardiovascular disease (all types)</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>chronicRespiratory</key>
            <label>Chronic respiratory disease</label>
            <kind>codedRate</kind>
            <concept>Chronic respiratory disease</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>chronicDisease</key>
            <label>Chronic diseases</label>
            <kind>codedRate</kind>
            <concept>Chronic diseases</concept>
            <answer>Yes</answer>
        </indicator>
        <indicator>
            <key>otherNcd</key>
            <label>Other NCD conditions</label>
            <kind>codedRate</kind>
            <concept>Other NCD conditions</concept>
            <answer>Yes</answer>
        </indicator>
    </indicators>

    <!--
         The leading conditions, which is how a morbidity summary is read: not
         "there were 412 cases" but "these are what is being seen". Limited to the
         busiest fifteen because a register names over a hundred conditions and
         a hundred-bar chart is not one.
    -->
