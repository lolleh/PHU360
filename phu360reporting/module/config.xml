<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<id>phu360reporting</id>
	<name>PHU360 Reporting</name>
	<version>1.0.0-SNAPSHOT</version>
	<package>org.openmrs.module.phu360reporting</package>
	<author>PHU360</author>
	<description>
		Facility reporting dashboard. Computes KPIs and trend indicators live
		from the OpenMRS database, filterable by date range, health center and
		encounter type. Aggregate data only - no patient identifiers.
	</description>

	<require_version>2.8.9</require_version>

	<!-- pihcore registers the per-program dashboard apps during its own
	     startup, and the activator trims them off the Program Dashboards
	     page. Requiring it guarantees that ordering, and declaring the
	     appframework dependency is what puts AppFrameworkService on this
	     module's classloader - the module's own lib/ is empty, so without
	     this the activator dies with NoClassDefFoundError. -->
	<require_modules>
		<require_module version="2.2.0-SNAPSHOT">org.openmrs.module.pihcore</require_module>
		<require_module version="2.20.0-SNAPSHOT">org.openmrs.module.appframework</require_module>
	</require_modules>

	<activator>org.openmrs.module.phu360reporting.Phu360ReportingActivator</activator>

	<servlet>
		<servlet-name>reportApi</servlet-name>
		<servlet-class>org.openmrs.module.phu360reporting.web.ReportApiServlet</servlet-class>
	</servlet>

</module>