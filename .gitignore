# OpenMRS distribution build
# ---------------------------
# Full materialized config produced by scripts/seed-distro-maven-repo.sh
# (stock image config + tracked delta - exclusions.txt). Only the tracked
# configuration/backend_configuration delta is committed.
content/build/
# content module build output (filtered content.properties + content zip)
content/target/
# distro module build output (target/distro/web -> OpenMRS SDK distribution dir)
distro/target/
# transient helper dir used while assembling zips
distro/template/

# branding build artifacts (logos rasterized into Java at build time)
.build/
branding/zpl/gen/

# local config / env
.env

# python bytecode from the openmrs-forms/ generators
__pycache__/
*.pyc

# 186MB patched OpenMRS WAR - build artifact, regenerated by
# openmrs-forms/above-five-treatment-register/build-patched-war.sh
openmrs-forms/above-five-treatment-register/openmrs-patched.war
openmrs-patched.war