# Copy to .env and adjust. docker compose loads this automatically;
# .env is gitignored so secrets never land in the repo.

# Name of the locally-built OpenMRS image (built from distro/Dockerfile after
# scripts/seed-distro-maven-repo.sh + scripts/build-distro.sh). To run the plain
# stock PIH SL image instead, set OPENMRS_IMAGE=partnersinhealth/pihsl-emr:latest.
OPENMRS_IMAGE=phu360:latest

# Host ports. OpenMRS binds 127.0.0.1:$OPENMRS_PORT, the DB binds
# 127.0.0.1:$OPENMRS_DB_PORT. Change these if a port is already in use
# (e.g. another OpenMRS/DHIS2 stack on this host).
OPENMRS_PORT=8090
OPENMRS_DB_PORT=3307
OPENMRS_HUB_PORT=8095

# PIH site config chain loaded at startup.
OPENMRS_PIH_CONFIG=sierraLeone,sierraLeone-kgh,sierraLeone-kgh-test
OPENMRS_HUB_PIH_CONFIG=sierraLeone,sierraLeone-hub
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123

OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=Admin123
OPENMRS_DB_ROOT_PASSWORD=Admin123

# Sync agent config
SYNC_AGENT_IMAGE=phu360-sync-agent:latest
SYNC_LOCAL_USERNAME=admin
SYNC_LOCAL_PASSWORD=Admin123
SYNC_HUB_USERNAME=sync-bot
SYNC_HUB_PASSWORD=sync-bot
SYNC_POLL_INTERVAL_MS=300000
SYNC_PAGE_SIZE=100
SYNC_OVERLAP_SECONDS=30
SYNC_PUSH_ENABLED=true
SYNC_PULL_ENABLED=true
MON_LOCAL_FHIR_URL=http://host.docker.internal:8082/openmrs/ws/fhir2/R4
SIN_LOCAL_FHIR_URL=http://host.docker.internal:8083/openmrs/ws/fhir2/R4
