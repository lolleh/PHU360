<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

	<!--
		The saved data exports live in one table of their own. An export never stores a statement:
		the definition column holds the query shape as JSON (columns, steps, filters, or a raw
		statement for the guarded raw path), and every run reads it back through the same builder that
		validates the live form, so a stored definition cannot drift out of reach of the allowlist.
	-->
	<changeSet id="clinicreporting-create-data-export-table" author="clinicreporting">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="clinicreporting_data_export"/>
			</not>
		</preConditions>
		<createTable tableName="clinicreporting_data_export"
			remarks="Saved data export definitions, the query shape only, never a statement">
			<column name="data_export_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="clinicreporting_data_export_pk"/>
			</column>
			<column name="uuid" type="varchar(38)">
				<constraints nullable="false" unique="true" uniqueConstraintName="clinicreporting_data_export_uu"/>
			</column>
			<column name="name" type="varchar(120)">
				<constraints nullable="false"/>
			</column>
			<column name="description" type="varchar(500)"/>
			<column name="source_table" type="varchar(64)">
				<constraints nullable="false"/>
			</column>
			<column name="definition" type="text"/>
			<column name="row_limit" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="creator" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by" type="int"/>
			<column name="date_changed" type="datetime"/>
			<column name="retired" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="date_retired" type="datetime"/>
			<column name="retired_by" type="int"/>
			<column name="retire_reason" type="varchar(255)"/>
		</createTable>
	</changeSet>


