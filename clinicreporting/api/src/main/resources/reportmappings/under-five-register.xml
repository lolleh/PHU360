<!--
     Data mapping for the under-five-register REPORT TYPE.

     Scoped to the register's own encounter type. The mapping this replaces
     listed fourteen paediatric and newborn encounter types because the
     register had no form of its own to attach to, so the only way to see
     an under-five visit was to guess which other service had seen the child.
     The form now exists - see
     content/configuration/backend_configuration/pih/htmlforms/underFiveIMNCIRegister.xml
     - and is digitised from the printed register "Under5 Register-IMNCI Final
     Print Review.xlsx", sheet "2 Month-5 Years Register". The 2-month to
     5-year register is a different document from the newborn register, so it
     is a different encounter type too, and this report reads only that one.

     The two paediatric outpatient types this mapping used to name are retired
     in sierraLeoneEncounterTypes_retired.csv and resolve to nothing, which is
     why the report showed no under-five visits at all.
-->
<reportMapping>

    <!-- The key the reportApi request carries and the filename of this file. -->
    <key>under-five-register</key>
    <label>Under Five Register (2 Months - 5 Years)</label>
    <table>phu360_report_under_five_register</table>

    <!-- Whether a mapping is defined. -->
    <mapped>true</mapped>

    <!-- Encounter type NAMES, resolved to ids per installation by
         ReportCatalog.Report.getEncounterTypeIds(). -->
    <encounterTypes>
        <!-- The type the register's form is attached to. -->
        <encounterType>Under Five IMNCI</encounterType>
    </encounterTypes>

    <!-- No <obsConcepts> block on purpose. That element carries the concept
         ids of the data package that exported the report, and
         ReportFilter.obsConceptsMissing() refuses to render a report when
         none of them is in this database - which is every install that has
         not loaded that package. This register's concepts are named below
         and are loaded by the register itself, so gating on a foreign
         package's ids would refuse the report on exactly the installations
         that have the data. -->

    <!--
         ============================================================================
         LAYOUT

         Concepts and answers are named, not numbered, and a name the running
         database does not have is dropped and reported back as
         "conceptsMissing" rather than shown as a zero - see
         ReportIndicators.resolve(). Every name below is generated from the
         same field spec that generates the form, so the report cannot end up
         asking about a question the form does not ask.
    ============================================================================
    -->
    <indicators>
        <indicator>
            <key>encounters</key>
            <label>Under-five visits recorded</label>
            <kind>encounterCount</kind>
        </indicator>
        <indicator>
            <key>children</key>
            <label>Children seen</label>
            <kind>distinctPatients</kind>
        </indicator>
        <indicator>
            <key>meanAgeMonths</key>
            <label>Mean age of the children seen (months)</label>
            <kind>meanAgeMonths</kind>
        </indicator>
        <indicator>
            <key>newVisits</key>
            <label>New visits</label>
            <kind>codedCount</kind>
            <concept>U5 Type of visit</concept>
            <answer>U5 New</answer>
        </indicator>
        <indicator>
            <key>followUpVisits</key>
            <label>Follow up visits</label>
            <kind>codedCount</kind>
            <concept>U5 Type of visit</concept>
            <answer>U5 Follow up</answer>
        </indicator>
        <indicator>
            <key>meanWeight</key>
            <label>Mean weight (kg)</label>
            <kind>numericMean</kind>
            <concept>U5 Weight (kg)</concept>
        </indicator>
        <indicator>
            <key>meanMuac</key>
            <label>Mean MUAC (cm)</label>
            <kind>numericMean</kind>
            <concept>U5 MUAC (cm)</concept>
        </indicator>
        <indicator>
            <key>meanTemp</key>
            <label>Mean temperature (C)</label>
            <kind>numericMean</kind>
            <concept>U5 Temperature (C)</concept>
        </indicator>
        <indicator>
            <key>exclusiveBreastfeeding</key>
            <label>Exclusive breastfeeding (children under 6 months)</label>
            <kind>codedRate</kind>
            <concept>U5 Exclusive breastfeeding under 6 months</concept>
            <answer>U5 Yes</answer>
        </indicator>
        <indicator>
            <key>continuedBreastfeeding</key>
            <label>Continued breastfeeding (children 6-23 months)</label>
            <kind>codedRate</kind>
            <concept>U5 Continued breastfeeding 6 to 23 months</concept>
            <answer>U5 Yes</answer>
        </indicator>
        <indicator>
            <key>vitaminA</key>
            <label>Vitamin A in the last 6 months (children 12-59 months)</label>
            <kind>codedRate</kind>
            <concept>U5 Vitamin A received in last 6 months age 12 to 59 months</concept>
            <answer>U5 Yes</answer>
        </indicator>
        <indicator>
            <key>albendazole</key>
            <label>Albendazole in the last 6 months (children 24-59 months)</label>
            <kind>codedRate</kind>
            <concept>U5 Albendazole received in last 6 months age 24 to 59 months</concept>
            <answer>U5 Yes</answer>
        </indicator>
    </indicators>

    <sections>
        <section>
            <key>visitType</key>
            <label>Visits by type</label>
            <kind>codedBreakdown</kind>
            <concept>U5 Type of visit</concept>
        </section>
        <section>
            <key>classification</key>
            <label>Disease classification</label>
            <kind>codedBreakdown</kind>
            <concept>U5 Primary classification</concept>
        </section>
        <section>
            <key>outcome</key>
            <label>Outcome</label>
            <kind>codedBreakdown</kind>
            <concept>U5 Outcome</concept>
        </section>
        <section>
            <key>disability</key>
            <label>Disability type</label>
            <kind>codedBreakdown</kind>
            <concept>U5 Type of disability</concept>
        </section>
        <section>
            <key>ageBands</key>
            <label>Children by age band</label>
            <kind>ageBreakdown</kind>
        </section>
        <section>
            <key>conditions</key>
            <label>Signs, conditions and services recorded</label>
            <kind>conditionBreakdown</kind>
        </section>
    </sections>

    <conditionConcepts>
        <!--
             The register's tick boxes. A tick box records the dictionary's
             own "Yes" as the answer, and conditionBreakdown counts a concept
             answered with it, so these are bare question names and name no
             answer of their own. Labels are shortened because a concept name
             is a column heading and an answer, and no use on an axis.

             Two lines are not ticks and say so, because the register does not
             print them as ticks:

               kind="recorded"  the drugs section prints "(No.)" and asks for a
                                count. Counted when a number above zero was
                                written, so a visit that gave no ORS is not
                                counted as having given one.
               kind="answer"    the disability census asks a question with the
                                register's own printed Yes/No marks, and
                                "Yes" there is this register's concept, not the
                                dictionary's. Counting it needs the answer
                                named, or the bar stays empty while the visits
                                are all recorded.

             Generated content and the prose around it are kept in step by
             openmrs-forms/under-five-imnci-register/verify_report_mapping.py,
             which fails if a name here is not a concept the form asks about.
        -->
