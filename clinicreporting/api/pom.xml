<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.openmrs.module</groupId>
		<artifactId>clinicreporting</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>clinicreporting-api</artifactId>
	<packaging>jar</packaging>
	<name>Clinic Reporting API</name>
	<description>API project for Clinic Reporting</description>

	<dependencies>

		<!-- Begin OpenMRS core -->
		<dependency>
			<groupId>org.openmrs.api</groupId>
			<artifactId>openmrs-api</artifactId>
			<type>jar</type>
		</dependency>

		<dependency>
			<groupId>org.openmrs.api</groupId>
			<artifactId>openmrs-api</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.test</groupId>
			<artifactId>openmrs-test</artifactId>
			<type>pom</type>
			<scope>test</scope>
		</dependency>
		<!-- End OpenMRS core -->

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<!--
			Compile- and test-only sight of the reporting module's API, used to mirror a saved export as
			a ReportDefinition on the reportingui Reports page. System-scoped because reporting's artifact
			is not published to the module's Maven repositories; the running server supplies the classes
			from the installed reporting module, and the module only touches them behind an availability
			guard. See lib/ and the README.
		-->
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>reporting-api</artifactId>
			<version>2.2.0-SNAPSHOT</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/../lib/reporting-api-2.2.0-SNAPSHOT.jar</systemPath>
		</dependency>

		<!--
			Compile- and test-only sight of the app framework's API, used to publish every saved export
			as a link on the reportingui Reports home page. System-scoped for the same reason as
			reporting-api above: the running server supplies the classes from the installed appframework
			module, which config.xml makes a requirement of this module. See lib/ and the README.
		-->
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>appframework-api</artifactId>
			<version>2.20.0-SNAPSHOT</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/../lib/appframework-api-2.20.0-SNAPSHOT.jar</systemPath>
		</dependency>

	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
				<filtering>true</filtering>
			</testResource>
		</testResources>
	</build>

</project>
